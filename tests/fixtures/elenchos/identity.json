[
  {
    "case": "file-region",
    "description": "a finding in a region of a file",
    "log": {
      "version": "2.1.0",
      "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json",
      "runs": [
        {
          "tool": {
            "driver": {
              "name": "anagraphe",
              "version": "0.0.0"
            }
          },
          "columnKind": "unicodeCodePoints",
          "results": [
            {
              "ruleId": "references/broken",
              "level": "error",
              "message": {
                "text": "finding"
              },
              "locations": [
                {
                  "physicalLocation": {
                    "artifactLocation": {
                      "uri": "docs/a.md",
                      "uriBaseId": "SRCROOT"
                    },
                    "region": {
                      "startLine": 12,
                      "startColumn": 3
                    }
                  },
                  "logicalLocations": [
                    {
                      "name": "path:docs/a.md#link:b.md"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "expected": [
      "anagraphe|references/broken|path:docs/a.md|link:b.md"
    ]
  },
  {
    "case": "line-moved",
    "description": "the finding of file-region after its line moved and its message and level changed",
    "log": {
      "version": "2.1.0",
      "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json",
