        {
          "tool": {
            "driver": {
              "name": "anagraphe",
              "version": "0.0.0"
            }
          },
          "columnKind": "unicodeCodePoints",
          "results": [
            {
              "ruleId": "references/broken",
              "level": "warning",
              "message": {
                "text": "target b.md is missing"
              },
              "locations": [
                {
                  "physicalLocation": {
                    "artifactLocation": {
                      "uri": "docs/a.md",
                      "uriBaseId": "SRCROOT"
                    },
                    "region": {
                      "startLine": 40,
                      "startColumn": 1
                    }
                  },
                  "logicalLocations": [
                    {
                      "name": "path:docs/a.md#link:b.md"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "expected": [
      "anagraphe|references/broken|path:docs/a.md|link:b.md"
    ]
  },
  {
    "case": "two-tools",
    "description": "two tools emit one ruleId at one locus",
    "log": {
      "version": "2.1.0",
      "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json",
      "runs": [
        {
          "tool": {
            "driver": {
              "name": "ekthesis",
              "version": "0.0.0"
            }
          },
          "columnKind": "unicodeCodePoints",
          "results": [
            {
              "ruleId": "schema-conformance",
              "level": "error",
              "message": {
                "text": "finding"
              },
              "locations": [
                {
                  "physicalLocation": {
                    "artifactLocation": {
                      "uri": "records/arg-ab12.yml",
                      "uriBaseId": "SRCROOT"
                    },
                    "region": {
                      "startLine": 9,
                      "startColumn": 5
                    }
                  },
                  "logicalLocations": [
                    {
                      "name": "id:arg-ab12#/relations/2/target"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "tool": {
            "driver": {
              "name": "gnomon",
              "version": "0.0.0"
            }
          },
          "columnKind": "unicodeCodePoints",
          "results": [
            {
              "ruleId": "schema-conformance",
              "level": "error",
              "message": {
                "text": "finding"
              },
              "locations": [
                {
                  "physicalLocation": {
                    "artifactLocation": {
                      "uri": "records/arg-ab12.yml",
                      "uriBaseId": "SRCROOT"
                    },
                    "region": {
                      "startLine": 9,
                      "startColumn": 5
                    }
                  },
                  "logicalLocations": [
                    {
                      "name": "id:arg-ab12#/relations/2/target"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "expected": [
      "ekthesis|schema-conformance|id:arg-ab12|/relations/2/target",
      "gnomon|schema-conformance|id:arg-ab12|/relations/2/target"
    ]
  },
